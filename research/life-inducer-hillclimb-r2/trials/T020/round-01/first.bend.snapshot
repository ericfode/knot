import Base

# Each U32 is a row: bit x is column x. A Count holds 32 independent
# four-bit neighbor counters, one counter in each bit lane.
type Count is Data:
  Count{ones: U32, twos: U32, fours: U32, eights: U32}

def Count.add(+mask: U32, count: Count) -> Count:
  match count:
    case Count{+ones, +twos, +fours, eights}:
      +to_twos = U32.and(ones, mask)
      +to_fours = U32.and(twos, to_twos)
      to_eights = U32.and(fours, to_fours)
      Count{
        U32.xor(ones, mask),
        U32.xor(twos, to_twos),
        U32.xor(fours, to_fours),
        U32.xor(eights, to_eights)
      }

# Counts two and three share the twos plane and have no higher plane.
# The ones plane selects birth at three; an existing cell admits two.
def Count.life(alive: U32, count: Count) -> U32:
  match count:
    case Count{ones, twos, fours, eights}:
      U32.and(
        U32.and(twos, U32.not(U32.or(fours, eights))),
        U32.or(ones, alive)
      )

def Row.step(+north: U32, +here: U32, +south: U32) -> U32:
  Count.life(here,
    Count.add(U32.shl(north),
      Count.add(north,
        Count.add(U32.shr(north),
          Count.add(U32.shl(here),
            Count.add(U32.shr(here),
              Count.add(U32.shl(south),
                Count.add(south,
                  Count.add(U32.shr(south), Count{0, 0, 0, 0})
                )
              )
            )
          )
        )
      )
    )
  )

def Row.pack(width: Nat, cells: List<&2, U32>) -> U32:
  match width cells:
    case 0n _:
      0
    case 1n+w Nil{}:
      0
    case 1n+w cell <> rest:
      U32.or(cell, U32.shl(Row.pack(w, rest)))

def Rows.pack(
  height: Nat, +width: Nat, +cells: List<&2, U32>
) -> List<&2, U32>:
  match height:
    case 0n:
      Nil{}
    case 1n+h:
      Row.pack(width, cells)
        <> Rows.pack(h, width, List.drop(&2, U32, cells, width))

def Row.unpack(width: Nat, +bits: U32) -> List<&2, U32>:
  match width:
    case 0n:
      Nil{}
    case 1n+w:
      U32.and(bits, 1) <> Row.unpack(w, U32.shr(bits))

def Rows.unpack(
  rows: List<&2, U32>, +width: Nat
) -> List<&2, U32>:
  match rows:
    case Nil{}:
      Nil{}
    case bits <> rest:
      List.append(&2, U32,
        Row.unpack(width, bits),
        Rows.unpack(rest, width)
      )

def Rows.step(
  rest: List<&2, U32>, north: U32, +here: U32
) -> List<&2, U32>:
  match rest:
    case Nil{}:
      Row.step(north, here, 0) <> Nil{}
    case +south <> tail:
      Row.step(north, here, south) <> Rows.step(tail, here, south)

def Rows.step.start(rows: List<&2, U32>) -> List<&2, U32>:
  match rows:
    case Nil{}:
      Nil{}
    case here <> rest:
      Rows.step(rest, 0, here)

def Rows.evolve(
  turns: Nat, rows: List<&2, U32>
) -> List<&2, U32>:
  match turns:
    case 0n:
      rows
    case 1n+more:
      Rows.evolve(more, Rows.step.start(rows))

def step(
  width: U32, height: U32, cells: List<&2, U32>
) -> List<&2, U32>:
  +span = U32.to_nat(width)
  Rows.unpack(
    Rows.step.start(Rows.pack(U32.to_nat(height), span, cells)),
    span
  )

def evolve(
  turns: Nat, width: U32, height: U32, cells: List<&2, U32>
) -> List<&2, U32>:
  +span = U32.to_nat(width)
  Rows.unpack(
    Rows.evolve(turns, Rows.pack(U32.to_nat(height), span, cells)),
    span
  )
