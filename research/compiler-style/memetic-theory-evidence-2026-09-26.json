      "start_line": 11,
      "lines": 6,
      "excerpt": "type Task is Type:\n  Work{destination: U32, remaining: Nat, payload: Payload, frames: List<&1,Frame>}\n\ntype Run is Type:\n  Checkpoint{task: Task}\n  Delivered{destination: U32, payload: Payload}",
      "excerpt_matches_head": true
    },
    {
      "path": "research/adaptive-tasks/task.bend",
      "source_sha256": "03d0139685cd66110a70101b6d74f5f903ab6cdc545f5735ed243314003ffb81",
      "start_line": 52,
      "lines": 4,
      "excerpt": "def run(fuel: Nat, state: Run) -> Run:\n  match fuel state:\n    case 1n+n Checkpoint{task}: run(n,step(task))\n    case _ _: state",
      "excerpt_matches_head": false
    },
    {
      "path": "research/adaptive-tasks/LAWS.bend",
      "source_sha256": "0c27192115eeb532b975fa642cd9d25e6e2187ca97431a838acfa20ec61bfc87",
      "start_line": 54,
      "lines": 5,
      "excerpt": "law fuel_add:\n  for n: Nat\n  for m: Nat\n  for r: T.Run\n  {T.run(m,T.run(n,r)) == T.run(Nat.add(n,m),r) : T.Run}",
      "excerpt_matches_head": true
    },
    {
      "path": "research/adaptive-tasks/PROOF.bend",
      "source_sha256": "f653d5802249799902e7fbaa33fff2868e7537fe3c272a92473f9f145ddd7125",
      "start_line": 19,
      "lines": 7,
      "excerpt": "def L.fuel_add(n,m,r):\n  match n r:\n    case 0n _: {==}\n    case 1n+k T.Checkpoint{task}:\n      L.fuel_add(k,m,T.step(task))\n    case 1n+k T.Delivered{d,p}:\n      L.delivered_absorbs(m,d,p)",
      "excerpt_matches_head": true
    },
    {
      "path": "research/adaptive-tasks/slot.bend",
      "source_sha256": "f8350b71240146dc6061543d32b36ca40f0f420953e074b12f76b90389314cf2",
      "start_line": 8,
      "lines": 3,
      "excerpt": "type Put<-T: Type> is Type:\n  Inserted{slot: Slot<T>}\n  Rejected{slot: Slot<T>, value: T}",
      "excerpt_matches_head": true
    },
    {
      "path": "research/adaptive-tasks/slot.bend",
      "source_sha256": "f8350b71240146dc6061543d32b36ca40f0f420953e074b12f76b90389314cf2",
      "start_line": 16,
      "lines": 4,
      "excerpt": "def put(-T: Type, s: Slot<T>, x: T) -> Put<T>:\n  match s:\n    case Vacant{}: Inserted{Occupied{x}}\n    case Occupied{value}: Rejected{Occupied{value},x}",
      "excerpt_matches_head": true
    }
