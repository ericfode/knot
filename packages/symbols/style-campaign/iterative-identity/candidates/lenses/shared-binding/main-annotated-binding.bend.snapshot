import Base
import 0xd684886d10b431b9dce6c3b2d1ef1980/main.bend as V

type Error is Data:
  InvalidId{}
  Exhausted{}

type Binding is Data:
  Bind{name: String, id: U32}

type Table is Type:
  InternTable{names: V.Vec<Binding>, forward: Map<&2,Maybe<&2,Binding>>}

type Side is Data:
  Name{}
  Id{}

def opposite(side: Side) -> Side:
  match side:
    case Name{}: Id{}
    case Id{}: Name{}

def Key(side: Side) -> Data:
  match side:
    case Name{}: String
    case Id{}: U32

def Binding.key(+side: Side, binding: Binding) -> Key(side):
  match side binding:
    case Name{} Bind{name,id}: name
    case Id{} Bind{name,id}: id

def Table.bounded(limit: U32) -> Table:
  InternTable{V.Vec.bounded(Binding,limit),Map.new(&2,Maybe<&2,Binding>)}

def Table.new() -> Table:
  InternTable{V.Vec.new(Binding),Map.new(&2,Maybe<&2,Binding>)}

def metadata(m: Map<&2,Maybe<&2,Binding>>, pair: V.Vec<Binding> & U32) -> Table & U32:
  (v,n) = pair
  (InternTable{v,m},n)

def Table.length(t: Table) -> Table & U32:
  match t:
    case InternTable{v,m}: metadata(m,V.Vec.length(Binding,v))

def Table.limit(t: Table) -> Table & U32:
  match t:
    case InternTable{v,m}: metadata(m,V.Vec.limit(Binding,v))

def cross_name(-R: Type, names: V.Vec<Binding>,
  pair: Map<&2,Maybe<&2,Binding>> & Maybe<&2,Binding>,
  missing: Table -> R, present: Table -> U32 -> R) -> R:
  match pair:
    case (ids,None{}): missing(InternTable{names,ids})
    case (ids,Some{binding}): present(InternTable{names,ids},Binding.key(Id{},binding))

def cross_id(-R: Type, ids: Map<&2,Maybe<&2,Binding>>,
  pair: V.Vec<Binding> & Result<V.Error,Binding>,
  missing: Table -> R, present: Table -> String -> R) -> R:
  match pair:
    case (names,Fail{error}): missing(InternTable{names,ids})
    case (names,Done{binding}): present(InternTable{names,ids},Binding.key(Name{},binding))

def Table.cross(-R: Type, +side: Side, t: Table, key: Key(side),
  missing: Table -> R, present: Table -> Key(opposite(side)) -> R) -> R:
  match side t:
    case Name{} InternTable{names,ids}:
      cross_name(R,names,Map.get(Maybe<&2,Binding>,None{},ids,key),missing,present)
    case Id{} InternTable{names,ids}:
      cross_id(R,ids,V.Vec.get(Binding,names,key),missing,present)

def Table.find(t: Table, name: String) -> Table & Maybe<&2,U32>:
  Table.cross(Table & Maybe<&2,U32>,Name{},t,name,
    t => (t,None{}), t => id => (t,Some{id}))

def Table.resolve(t: Table, id: U32) -> Table & Result<Error,String>:
  Table.cross(Table & Result<Error,String>,Id{},t,id,
    t => (t,Fail{InvalidId{}}), t => name => (t,Done{name}))

def inserted(m: Map<&2,Maybe<&2,Binding>>, +binding: Binding,
  pair: V.Vec<Binding> & Result<V.Error,Unit>) -> Table & Result<Error,U32>:
  match pair:
    case (v,Fail{error}): (InternTable{v,m},Fail{Exhausted{}})
    case (v,Done{unit}):
      (InternTable{v,Map.set(&2,Maybe<&2,Binding>,m,Binding.key(Name{},binding),Some{binding})},
        Done{Binding.key(Id{},binding)})

def append_name(m: Map<&2,Maybe<&2,Binding>>, name: String,
  pair: V.Vec<Binding> & U32) -> Table & Result<Error,U32>:
  (v,id) = pair
  +binding = {Bind{name,id} : Binding}
  inserted(m,binding,V.Vec.push(Binding,v,binding))

def Table.intern(t: Table, +name: String) -> Table & Result<Error,U32>:
  Table.cross(Table & Result<Error,U32>,Name{},t,name,
    \{InternTable: names => ids => append_name(ids,name,V.Vec.length(Binding,names))},
    t => id => (t,Done{id}))
