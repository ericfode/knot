import Base
import 0xd684886d10b431b9dce6c3b2d1ef1980/main.bend as V

type Error is Data:
  InvalidId{}
  Exhausted{}

type Color is Data:
  Red{}
  Black{}

type Entry is Data:
  Bind{name: String, id: U32}

type Index is Data:
  Leaf{}
  Node{color: Color, left: Index, entry: Entry, right: Index}

type Table is Type:
  InternTable{names: V.Vec<String>, forward: Index}

def Table.bounded(limit: U32) -> Table:
  InternTable{V.Vec.bounded(String,limit),Leaf{}}

def Table.new() -> Table:
  InternTable{V.Vec.new(String),Leaf{}}

def metadata(m: Index, pair: V.Vec<String> & U32) -> Table & U32:
  (v,n) = pair
  (InternTable{v,m},n)

def Table.length(t: Table) -> Table & U32:
  match t:
    case InternTable{v,m}: metadata(m,V.Vec.length(String,v))

def Table.limit(t: Table) -> Table & U32:
  match t:
    case InternTable{v,m}: metadata(m,V.Vec.limit(String,v))

def order(a: String, b: String) -> Cmp:
  Pair.snd(String & String,Cmp,String.cmp(a,b))

def seek(left: Index, id: U32, right: Index, cmp: Cmp,
  next: Index -> Maybe<&2,U32>) -> Maybe<&2,U32>:
  match cmp:
    case LT{}: next(left)
    case EQ{}: Some{id}
    case GT{}: next(right)

def Index.find(tree: Index, +name: String) -> Maybe<&2,U32>:
  match tree:
    case Leaf{}: None{}
    case Node{color,left,Bind{key,id},right}:
      seek(left,id,right,order(name,key),t => Index.find(t,name))

def promote(a: Index, x: Entry, b: Index, y: Entry, c: Index, z: Entry, d: Index) -> Index:
  Node{Red{},Node{Black{},a,x,b},y,Node{Black{},c,z,d}}

def balance(tree: Index) -> Index:
  match tree:
    case Node{Black{},Node{Red{},Node{Red{},a,x,b},y,c},z,d}:
      promote(a,x,b,y,c,z,d)
    case Node{Black{},Node{Red{},a,x,Node{Red{},b,y,c}},z,d}:
      promote(a,x,b,y,c,z,d)
    case Node{Black{},a,x,Node{Red{},Node{Red{},b,y,c},z,d}}:
      promote(a,x,b,y,c,z,d)
    case Node{Black{},a,x,Node{Red{},b,y,Node{Red{},c,z,d}}}:
      promote(a,x,b,y,c,z,d)
    case _: tree

def descend(color: Color, left: Index, entry: Entry, right: Index,
  cmp: Cmp, next: Index -> Index) -> Index:
  match cmp:
    case LT{}: balance(Node{color,next(left),entry,right})
    case EQ{}: Node{color,left,entry,right}
    case GT{}: balance(Node{color,left,entry,next(right)})

def Index.insert(tree: Index, +name: String, id: U32) -> Index:
  match tree:
    case Leaf{}: Node{Red{},Leaf{},Bind{name,id},Leaf{}}
    case Node{color,left,Bind{+key,old},right}:
      descend(color,left,Bind{key,old},right,order(name,key),t => Index.insert(t,name,id))

def blacken(tree: Index) -> Index:
  match tree:
    case Leaf{}: Leaf{}
    case Node{color,left,entry,right}: Node{Black{},left,entry,right}

def Table.find(t: Table, name: String) -> Table & Maybe<&2,U32>:
  match t:
    case InternTable{v,+m}: (InternTable{v,m},Index.find(m,name))

def inserted(m: Index, name: String, +id: U32,
  pair: V.Vec<String> & Result<V.Error,Unit>) -> Table & Result<Error,U32>:
  (v,result) = pair
  match result:
    case Fail{error}: (InternTable{v,m},Fail{Exhausted{}})
    case Done{unit}: (InternTable{v,blacken(Index.insert(m,name,id))},Done{id})

def append_name(m: Index, +name: String, pair: V.Vec<String> & U32) -> Table & Result<Error,U32>:
  (v,id) = pair
  inserted(m,name,id,V.Vec.push(String,v,name))

def intern_found(v: V.Vec<String>, m: Index, name: String,
  lookup: Maybe<&2,U32>) -> Table & Result<Error,U32>:
  match lookup:
    case Some{id}: (InternTable{v,m},Done{id})
    case None{}: append_name(m,name,V.Vec.length(String,v))

def Table.intern(t: Table, +name: String) -> Table & Result<Error,U32>:
  match t:
    case InternTable{v,+m}: intern_found(v,m,name,Index.find(m,name))

def resolved(m: Index, pair: V.Vec<String> & Result<V.Error,String>) -> Table & Result<Error,String>:
  (v,result) = pair
  match result:
    case Fail{error}: (InternTable{v,m},Fail{InvalidId{}})
    case Done{name}: (InternTable{v,m},Done{name})

def Table.resolve(t: Table, id: U32) -> Table & Result<Error,String>:
  match t:
    case InternTable{v,m}: resolved(m,V.Vec.get(String,v,id))
