import Base
# rn(m)∘rn(n)=rn(n+m) by rc
type Oc is Data: P{v:U32} O{r:U32,v:U32}
def ow(+r:U32,+v:U32)->Oc:Bool.pick(Oc,U32.is_zero(r),P{v},O{r,v})
def tk(o:Oc)->Oc:match o:case P{v}:P{v} case O{+r,v}:ow((r-1:U32),(v*3+ r% 7:U32))
def rn(n:Nat,o:Oc)->Oc:match n:case 0n:o case 1n+k:rn(k,tk(o))
law rc:for m:Nat for n:Nat for o:Oc {rn(m,rn(n,o))==rn(Nat.add(n,m),o):Oc}
def rc(m,n,o):match n:case 0n:{==} case 1n+k:rc(m,k,tk(o))

# ---- harness (not shown) ----
def h_start(+n: U32) -> Oc:
  ow((n % 40 : U32), n)

def h_run(f: Nat, x: Oc) -> Oc:
  rn(f, x)

def h_code(x: Oc) -> U32:
  match x:
    case P{v}: (v * 2 + 1 : U32)
    case O{r, v}: (r * 2 : U32)

def h_splits(+n: U32, s: List<&2, Nat>) -> List<&2, U32>:
  match s:
    case Nil{}: Nil{}
    case Con{a, Nil{}}: Nil{}
    case Con{+a, Con{+b, rest}}:
      h_code(h_run(Nat.add(a, b), h_start(n)))
        <> h_code(h_run(b, h_run(a, h_start(n))))
        <> h_splits(n, rest)

# For each split (a, b): run(a + b, t) then run(b, run(a, t)).
def scenario(+n: U32) -> List<&2, U32>:
  h_splits(n, [0n, 0n, 0n, 1n, 1n, 0n, 2n, 3n, 5n, 8n, 13n, 21n,
               20n, 19n, 34n, 6n, 39n, 1n, 40n, 0n, 3n, 50n, 17n, 17n])