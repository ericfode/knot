# Copy to .env and populate privately, once, in the main checkout. Perch loads
# .env at the Git root; the npm wrappers make linked worktrees (.claude/worktrees,
# .codex/worktrees) read the main checkout's .env automatically. Do not copy it.
# Obtain a key at https://console.typesafe.ai; never commit the populated file.
PERCH_API_KEY=
# TYPESAFE_API_KEY is also accepted by Perch and the existing Bend Jev client.
# PERCH_MODEL_ID=jev-latest
