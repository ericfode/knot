# The other order of the same offsets: the pattern sits later in main than the imported constructors.
import ./qualified-order-lib-last/lib.bend as L

type Answer is Type:
  No{}
  Yes{}

# 
def g(a: Answer, b: L.Flag) -> Answer:
  match b:
    case L.On{}: a
    case L.Off{}: No{}

def f(a: Answer) -> Answer:
  g(a, L.On{})

def main() -> Answer:
  f(Yes{})
